{
  "name": "markcraft",
  "version": "1.1.1",
  "description": "Free, open-source Markdown viewer, editor and reviewer for Chrome",
  "homepage": "https://markcraft.cc",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhangweiii/markcraft.git"
  },
  "bugs": {
    "url": "https://github.com/zhangweiii/markcraft/issues"
  },
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "test": "node scripts/test.mjs",
    "package": "node build.mjs && node scripts/package.mjs",
    "screenshots": "node build.mjs && node scripts/screenshots.mjs",
    "store-assets": "node scripts/store-assets.mjs"
  },
  "keywords": [
    "markdown",
    "chrome-extension",
    "mermaid",
    "katex",
    "viewer",
    "editor"
  ],
  "author": "",
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright": "^1.64.1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "@milkdown/crepe": "^7.22.3",
    "@milkdown/kit": "^7.22.3",
    "@viz-js/viz": "^3.31.0",
    "diff": "^9.0.0",
    "docx": "^9.13.0",
    "dompurify": "^3.4.17",
    "highlight.js": "^11.12.0",
    "json5": "^2.2.3",
    "katex": "^0.19.0",
    "lucide": "^1.61.0",
    "marked": "^18.1.1",
    "marked-alert": "^2.1.2",
    "marked-extended-tables": "^2.0.1",
    "marked-footnote": "^1.4.0",
    "marked-gfm-heading-id": "^4.1.4",
    "marked-highlight": "^2.2.4",
    "marked-smartypants": "^1.1.12",
    "markmap-common": "^0.18.9",
    "markmap-lib": "^0.18.12",
    "markmap-view": "^0.18.12",
    "mermaid": "^12.2.0",
    "node-emoji": "^2.2.0",
    "wavedrom": "^3.7.0"
  }
}
