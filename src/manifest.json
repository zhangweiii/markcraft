{
  "manifest_version": 3,
  "name": "MarkCraft – Markdown Viewer & Editor",
  "short_name": "MarkCraft",
  "description": "Render, edit and review Markdown in Chrome: GFM, TOC, find, live reload with diffs, WYSIWYG editing, review comments and AI agent hand-off.",
  "version": "0.0.0",
  "key": "",
  "minimum_chrome_version": "110",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "permissions": ["storage", "unlimitedStorage", "contextMenus", "nativeMessaging", "clipboardWrite"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["file:///*", "http://*/*", "https://*/*"],
      "js": ["detect.js"],
      "run_at": "document_start"
    }
  ],
  "action": { "default_popup": "popup.html", "default_title": "MarkCraft" },
  "options_page": "options.html",
  "web_accessible_resources": [{ "resources": ["viewer.html"], "matches": ["<all_urls>"] }],
  "commands": {
    "open-file": { "suggested_key": { "default": "Alt+Shift+O" }, "description": "Open a Markdown file in MarkCraft" },
    "new-doc": { "suggested_key": { "default": "Alt+Shift+N" }, "description": "New Markdown document" }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
